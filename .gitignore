# Ignore everything by default
/*

# Allow essential project directories
!/backend/
!/frontend/
!/PRD/
!.github/

# Keep this gitignore file tracked
!.gitignore

# Allow deployment and documentation files
!*.sh
!*.md

# Backend ignores
backend/data/instruments.json
backend/data/instruments_expiries.json
backend/venv/
backend/staticfiles/
backend/.env
backend/db.sqlite3

# Frontend ignores
frontend/node_modules/
frontend/dist/
frontend/assets/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

