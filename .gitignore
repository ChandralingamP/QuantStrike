# Ignore everything by default
/*

# Allow essential project directories
!/backend/
!/frontend/
!/PRD/

# Keep these root files tracked
!.gitignore
!README.md
!LOCAL_SETUP_GUIDE.md
!.github/
!.vscode/
!start-server.ps1
!start-server.bat

# Backend ignores
backend/venv/
backend/staticfiles/
backend/.env
backend/db.sqlite3
backend/logs/**
!backend/logs/.gitkeep
!backend/logs/users/
!backend/logs/users/.gitkeep
backend/data/instruments.json
backend/data/instruments_expiries.json
backend/__pycache__/
backend/api/__pycache__/
backend/api/**/__pycache__/

# Frontend ignores
frontend/node_modules/
frontend/dist/
frontend/assets/

# Backups and data dumps
*.sql
*.tar.gz

# Docker (no longer used)
Dockerfile
docker-compose.yml

# IDEs
.vscode/*
!.vscode/tasks.json
.idea/
*.swp
*.swo
*~

